# OpenRouter API key used for CV scoring. Get one at https://openrouter.ai/keys.
OPENROUTER_API_KEY=sk-or-v1-...

# Model id used for scoring. Any OpenRouter model that supports Structured
# Outputs will work; the default matches app.config.DEFAULT_MODEL.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Set to 1 in production so the session cookie is only sent over HTTPS.
# Leave unset in local development.
JOBFIT_COOKIE_SECURE=0
